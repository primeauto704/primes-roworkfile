# Primes Auto — RO Workflow portal
# Copy to .env and edit. All values are optional; defaults shown.

# Port and bind address
PORT=8090
HOST=0.0.0.0

# Where the SQLite database lives (created automatically)
DB_FILE=./data/ro-workflow.sqlite

# Folder containing credentials.json (written by `npm run setup`)
CONFIG_DIR=./config

# --- Shop login via environment (optional; overrides config/credentials.json) ---
# Generate the hash with:  npm run setup -- --hash-only
# SHOP_USERNAME=shop
# SHOP_PASSWORD_HASH=scrypt$32768$8$1$...

# Set to true when the portal is served over HTTPS (behind a reverse proxy) so the
# session cookie is marked Secure. Leave false on plain http://localhost or LAN use.
COOKIE_SECURE=false
# Set to true only when running behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false

NODE_ENV=production
